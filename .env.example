# Only needed when the frontend is hosted separately from the API (for example a static host
# plus a backend elsewhere). Copy to .env.local; leave unset when FastAPI serves the app itself.
VITE_API_BASE_URL=https://your-kolam-api.example.com

# Backend (environment variables of the FastAPI process):
# CORS_ORIGINS=https://your-frontend.example.com   # comma separated
# MAX_UPLOAD_BYTES=8388608
# PORT=8000
# MAX_PIXELS=40000000            # refuse pictures with more pixels than this (width x height)
# MAX_SIDE=1600                  # photos are reduced to this long side before being read
# MAX_CONCURRENT=2               # photos read at the same moment
# MAX_WAITING=12                 # photos allowed to wait in line before the server says "busy"
# RATE_LIMIT_PER_MINUTE=20       # photos one visitor can have read per minute
# TRUST_PROXY=1                  # 1 behind a hosting proxy (Render): visitor = last X-Forwarded-For entry
